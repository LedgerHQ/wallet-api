{
  "name": "@ledgerhq/wallet-api",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "clean": "git clean -fdX",
    "changelog": "changeset add",
    "build": "turbo run build",
    "build:client": "turbo run build --filter=wallet-api-client",
    "dev": "turbo run dev --filter=!./examples/*",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format:check": "turbo run format:check",
    "format:fix": "turbo run format:fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@ledgerhq/eslint-config-custom": "workspace:*",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "2.9.16"
  },
  "engines": {
    "node": "^22.13.0 || ^24 || >=26",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "dependencies": {
    "@tsconfig/recommended": "^1.0.13"
  }
}
