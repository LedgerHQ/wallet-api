{
  "name": "@ledgerhq/wallet-api",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "clean": "git clean -fdX",
    "changelog": "changeset add",
    "build": "turbo run build",
    "build:client": "turbo run build --filter=wallet-api-client",
    "dev": "turbo run dev --filter=!./examples/*",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format:check": "turbo run format:check",
    "format:fix": "turbo run format:fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@ledgerhq/eslint-config-custom": "workspace:*",
    "eslint": "10.15.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.13"
  },
  "engines": {
    "node": "^22.13.0 || ^24 || >=26",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "dependencies": {
    "@tsconfig/recommended": "^1.0.13"
  }
}
